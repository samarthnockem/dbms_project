CREATE TABLE Branch (
    Branch_ID    SERIAL PRIMARY KEY,
    Branch_Name  VARCHAR(50) NOT NULL,
    City         VARCHAR(50) NOT NULL
);

CREATE TABLE Customer (
    Customer_ID   SERIAL PRIMARY KEY,
    Name          VARCHAR(100) NOT NULL,
    Phone         VARCHAR(15),
    Email         VARCHAR(100) UNIQUE NOT NULL,
    Address       VARCHAR(200),
    Date_Of_Birth DATE NOT NULL,
    Joining_Date  DATE NOT NULL,
    Password      VARCHAR(255) NOT NULL
);

CREATE TABLE Account_Type (
    Type_Code      VARCHAR(5) PRIMARY KEY,
    Description    VARCHAR(50) NOT NULL,
    Interest_Rate  DECIMAL(5,2) NOT NULL,
    Min_Balance    DECIMAL(12,2) NOT NULL
);

CREATE TABLE Account (
    Account_No   SERIAL PRIMARY KEY,
    Customer_ID  INT NOT NULL,
    Type_Code    VARCHAR(5) NOT NULL,
    Branch_ID    INT NOT NULL,
    Balance      DECIMAL(12,2) NOT NULL DEFAULT 0 CHECK (Balance >= 0),
    Status       VARCHAR(10) NOT NULL DEFAULT 'ACTIVE'
                 CHECK (Status IN ('ACTIVE','FROZEN','CLOSED')),
    Date_Opened  DATE NOT NULL,
    FOREIGN KEY (Customer_ID) REFERENCES Customer(Customer_ID),
    FOREIGN KEY (Type_Code)   REFERENCES Account_Type(Type_Code),
    FOREIGN KEY (Branch_ID)   REFERENCES Branch(Branch_ID)
);

CREATE TABLE Transaction_Type (
    Txn_Type_Code VARCHAR(5) PRIMARY KEY,
    Description   VARCHAR(50) NOT NULL
);

CREATE TABLE Transactions (
    Txn_ID        SERIAL PRIMARY KEY,
    Txn_Type_Code VARCHAR(5) NOT NULL,
    From_Account  INT,
    To_Account    INT,
    Amount        DECIMAL(12,2) NOT NULL CHECK (Amount > 0),
    Txn_Date      DATE NOT NULL,
    FOREIGN KEY (Txn_Type_Code) REFERENCES Transaction_Type(Txn_Type_Code),
    FOREIGN KEY (From_Account)  REFERENCES Account(Account_No),
    FOREIGN KEY (To_Account)    REFERENCES Account(Account_No),
    CHECK (From_Account IS NOT NULL OR To_Account IS NOT NULL)
);

CREATE TABLE Loan (
    Loan_ID       SERIAL PRIMARY KEY,
    Customer_ID   INT NOT NULL,
    Branch_ID     INT NOT NULL,
    Principal     DECIMAL(12,2) NOT NULL CHECK (Principal > 0),
    Interest_Rate DECIMAL(5,2) NOT NULL,
    Term_Months   INT NOT NULL CHECK (Term_Months > 0),
    Status        VARCHAR(10) NOT NULL DEFAULT 'APPLIED'
                  CHECK (Status IN ('APPLIED','APPROVED','ACTIVE','CLOSED')),
    Start_Date    DATE,
    FOREIGN KEY (Customer_ID) REFERENCES Customer(Customer_ID),
    FOREIGN KEY (Branch_ID)   REFERENCES Branch(Branch_ID)
);
